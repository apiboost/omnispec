# Block a push when any commit being pushed lacks a DCO `Signed-off-by` trailer.
# The repo's DCO check fails the PR otherwise — and it checks EVERY commit,
# including merge commits (GitHub's "Update branch" button creates an unsigned
# merge that fails DCO). Catch it locally before the push instead of after.

remote_name="$1"
zero="0000000000000000000000000000000000000000"
fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Branch deletion — nothing to verify.
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_sha" = "$zero" ]; then
    # New branch on the remote: check commits not already on any remote branch.
    range="$local_sha --not --remotes=$remote_name"
  else
    # Existing branch: check only the commits this push adds.
    range="$remote_sha..$local_sha"
  fi

  # Unquoted on purpose so the new-branch form word-splits into separate args.
  for sha in $(git rev-list $range); do
    if [ -z "$(git show -s --format='%(trailers:key=Signed-off-by,valueonly)' "$sha")" ]; then
      echo "✗ DCO: missing Signed-off-by on $(git show -s --format='%h %s' "$sha")"
      fail=1
    fi
  done
done

if [ "$fail" -ne 0 ]; then
  cat <<'EOF'

Push blocked: a commit is missing a DCO `Signed-off-by` trailer, so the repo's
DCO check would fail the PR. To fix:

  git rebase --signoff origin/<base>     # sign off every commit, then
  git push --force-with-lease            # feature branches only

Tip: do NOT use GitHub's "Update branch" button (it makes an unsigned merge
commit). Bring the base into your PR branch with `git rebase origin/<base>`.
EOF
  exit 1
fi
