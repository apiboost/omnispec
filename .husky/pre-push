# Block a push when any commit being pushed lacks a DCO `Signed-off-by` trailer.
# The repo's DCO check (`.github/workflows/dco.yml`) fails the PR otherwise — and
# it checks EVERY commit, including merge commits (GitHub's "Update branch" button
# creates an unsigned merge that fails DCO). Catch it locally, before the push.
#
# Scope: branch pushes only. Tag and notes pushes (e.g. semantic-release in CI)
# are skipped — they carry commits this hook has no say over, and CI sets HUSKY=0
# anyway. The sign-off pattern mirrors dco.yml exactly so the two never disagree.

zero="0000000000000000000000000000000000000000"
fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Branch deletion — nothing to verify.
  [ "$local_sha" = "$zero" ] && continue

  # Only enforce on branch pushes; leave tags and notes alone.
  case "$local_ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac

  # Check the commits this push would add that aren't already on any
  # remote-tracking branch. Works for a brand-new branch and an existing one
  # alike, and never re-checks commits already pushed elsewhere (e.g. syncing
  # `main` into `next`).
  for sha in $(git rev-list "$local_sha" --not --remotes); do
    if ! git log -1 --format=%B "$sha" | grep -qiE '^Signed-off-by: .+ <.+@.+>'; then
      echo "✗ DCO: missing Signed-off-by on $(git show -s --format='%h %s' "$sha")"
      fail=1
    fi
  done
done

if [ "$fail" -ne 0 ]; then
  cat <<'EOF'

Push blocked: a commit is missing a DCO `Signed-off-by` trailer, so the repo's
DCO check would fail the PR. To fix:

  git rebase --signoff origin/<base>     # sign off every commit, then
  git push --force-with-lease            # feature branches only

Tip: do NOT use GitHub's "Update branch" button (it makes an unsigned merge
commit). Bring the base into your PR branch with `git rebase origin/<base>`.

Escape hatch: `git push --no-verify` skips this hook (CI still enforces DCO).
EOF
  exit 1
fi
